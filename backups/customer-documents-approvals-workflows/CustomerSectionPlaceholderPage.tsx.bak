import React from 'react';
import { useNavigate } from 'react-router-dom';
import { useTranslation } from 'react-i18next';
import type { LucideIcon } from 'lucide-react';
import {
    LayoutDashboard,
    FileText,
    ShieldCheck,
    GitBranch,
    Ticket,
    History,
    CalendarClock,
    FolderGit2,
} from 'lucide-react';

export type CustomerNavigationGroupKey =
    | 'overviewAndCommercial'
    | 'operationsAndServiceDelivery'
    | 'organizationAndResources'
    | 'governanceAndSupport'
    | 'auditTrail';

export type CustomerPageTranslationKey =
    | 'dashboard'
    | 'companies'
    | 'deals'
    | 'quotations'
    | 'contracts'
    | 'invoices'
    | 'services'
    | 'servicePackages'
    | 'requests'
    | 'operationalTasks'
    | 'contacts'
    | 'owners'
    | 'branches'
    | 'departments'
    | 'employees'
    | 'assets'
    | 'documents'
    | 'approvalTasks'
    | 'workflows'
    | 'tickets'
    | 'auditTrail';

export interface CustomerSectionPlaceholderProps {
    pageKey: CustomerPageTranslationKey;
    groupKey: CustomerNavigationGroupKey;
    routePath: string;
    code: string;
    icon: LucideIcon;
}

export const CustomerSectionPlaceholder: React.FC<CustomerSectionPlaceholderProps> = ({
    pageKey,
    groupKey,
    routePath,
    code,
    icon: Icon,
}) => {
    const { t } = useTranslation();
    const navigate = useNavigate();

    const title = t(`customer.pages.${pageKey}.title`);
    const subtitle = t(`customer.pages.${pageKey}.subtitle`);
    const phase = t(`customer.pages.${pageKey}.phase`);
    const groupTitle = t(`customer.groups.${groupKey}`);
    const isDashboard = pageKey === 'dashboard';

    return (
        <div className="space-y-6 text-start">
            <div className="bg-white border border-[#E5E0D8] rounded-xl p-6 sm:p-8 shadow-2xs space-y-6">
                <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div className="flex items-start sm:items-center gap-4">
                        <div className="w-12 h-12 rounded-xl bg-[#2D3F2C] text-[#FAF8F5] flex items-center justify-center shadow-xs shrink-0">
                            <Icon className="w-6 h-6 text-[#BFAB93]" />
                        </div>
                        <div>
                            <div className="flex flex-wrap items-center gap-2">
                                <h1 className="text-xl font-bold text-[#0D0D0D]">
                                    {title}
                                </h1>
                                <span
                                    className="px-2.5 py-0.5 text-[11px] font-mono font-semibold uppercase rounded-full bg-[#EFECE6] text-[#2D3F2C] border border-[#D6CFC4]"
                                    dir="ltr"
                                >
                                    {code}
                                </span>
                            </div>
                            <p className="text-xs text-[#6E6862] mt-1">
                                {subtitle}
                            </p>
                        </div>
                    </div>

                    <div className="flex items-center gap-2 self-start sm:self-center shrink-0">
                        {!isDashboard && (
                            <button
                                type="button"
                                onClick={() => navigate('/customer/dashboard')}
                                className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white hover:bg-[#FAF8F5] border border-[#E5E0D8] text-xs font-medium text-[#0D0D0D] transition-colors cursor-pointer shadow-2xs"
                            >
                                <LayoutDashboard className="w-3.5 h-3.5 text-[#857E74]" />
                                <span>{t('customer.goToDashboard')}</span>
                            </button>
                        )}
                        <span className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-[#EAF3EC] text-[#265938] border border-[#C5DFCC]">
                            <ShieldCheck className="w-3.5 h-3.5" />
                            <span>{t('customer.phaseBadge')}</span>
                        </span>
                    </div>
                </div>

                <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div className="p-4 rounded-xl bg-[#FAF8F5] border border-[#E5E0D8]">
                        <p className="text-[11px] font-semibold uppercase tracking-wider text-[#857E74]">
                            {t('customer.groupLabel')}
                        </p>
                        <p className="text-sm font-bold text-[#0D0D0D] mt-1">
                            {groupTitle}
                        </p>
                    </div>

                    <div className="p-4 rounded-xl bg-[#FAF8F5] border border-[#E5E0D8]">
                        <p className="text-[11px] font-semibold uppercase tracking-wider text-[#857E74]">
                            {t('customer.routeLabel')}
                        </p>
                        <p className="text-sm font-mono font-semibold text-[#2D3F2C] mt-1" dir="ltr">
                            {routePath}
                        </p>
                    </div>

                    <div className="p-4 rounded-xl bg-[#FAF8F5] border border-[#E5E0D8]">
                        <div className="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-[#857E74]">
                            <CalendarClock className="w-3.5 h-3.5 text-[#2D3F2C]" />
                            <span>{t('customer.upcomingPhaseLabel')}</span>
                        </div>
                        <p className="text-sm font-bold text-[#0D0D0D] mt-1">
                            {phase}
                        </p>
                    </div>
                </div>

                <div className="p-5 rounded-xl bg-[#FAF8F5] border border-[#E5E0D8] flex items-start gap-3">
                    <FolderGit2 className="w-5 h-5 text-[#265938] shrink-0 mt-0.5" />
                    <div>
                        <p className="text-sm font-semibold text-[#0D0D0D]">
                            {t('customer.foundationNoticeTitle')}
                        </p>
                        <p className="text-xs text-[#6E6862] mt-0.5">
                            {t('customer.foundationNoticeDesc')}
                        </p>
                    </div>
                </div>
            </div>
        </div>
    );
};

// ============================================================================
// 1. Overview & Commercial (6 routes)
// ============================================================================

export { CustomerDashboardPage } from './CustomerDashboardPage';

export { CustomerCompaniesPage } from './CustomerCompaniesPage';

export { CustomerDealsPage } from './CustomerDealsPage';

export { CustomerQuotationsPage } from './CustomerQuotationsPage';

export { CustomerContractsPage } from './CustomerContractsPage';

export { CustomerInvoicesPage } from './CustomerInvoicesPage';

// ============================================================================
// 2. Operations & Service Delivery (4 routes)
// ============================================================================

export { CustomerServicesPage } from './CustomerServicesPage';

export { CustomerServicePackagesPage } from './CustomerServicePackagesPage';

export { CustomerRequestsPage } from './CustomerRequestsPage';

export { CustomerOperationalTasksPage } from './CustomerOperationalTasksPage';

// ============================================================================
// 3. Organization & Resources (6 routes)
// ============================================================================

export { CustomerContactsPage } from './CustomerContactsPage';

export { CustomerOwnersPage } from './CustomerOwnersPage';

export { CustomerBranchesPage } from './CustomerBranchesPage';

export { CustomerDepartmentsPage } from './CustomerDepartmentsPage';

export { CustomerEmployeesPage } from './CustomerEmployeesPage';

export { CustomerAssetsPage } from './CustomerAssetsPage';

// ============================================================================
// 4. Governance & Support (4 routes)
// ============================================================================

export const CustomerDocumentsPage: React.FC = () => (
    <CustomerSectionPlaceholder
        pageKey="documents"
        groupKey="governanceAndSupport"
        routePath="/customer/documents"
        code="CST-DOC"
        icon={FileText}
    />
);

export const CustomerApprovalTasksPage: React.FC = () => (
    <CustomerSectionPlaceholder
        pageKey="approvalTasks"
        groupKey="governanceAndSupport"
        routePath="/customer/approval-tasks"
        code="CST-APR"
        icon={ShieldCheck}
    />
);

export const CustomerWorkflowsPage: React.FC = () => (
    <CustomerSectionPlaceholder
        pageKey="workflows"
        groupKey="governanceAndSupport"
        routePath="/customer/workflows"
        code="CST-WFL"
        icon={GitBranch}
    />
);

export const CustomerTicketsPage: React.FC = () => (
    <CustomerSectionPlaceholder
        pageKey="tickets"
        groupKey="governanceAndSupport"
        routePath="/customer/tickets"
        code="CST-TCK"
        icon={Ticket}
    />
);

// ============================================================================
// 5. Audit Trail (1 route)
// ============================================================================

export const CustomerAuditTrailPage: React.FC = () => (
    <CustomerSectionPlaceholder
        pageKey="auditTrail"
        groupKey="auditTrail"
        routePath="/customer/audit-trail"
        code="CST-AUD"
        icon={History}
    />
);
